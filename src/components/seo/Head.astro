---
import { business } from '@/lib/business';
import { site } from '@/lib/site';
import { defaultLocale } from '@/i18n/locales';

interface Props {
  title: string;
  description: string;
  path: string;
  graph: object;
  noindex?: boolean;
}
const { title, description, path, graph, noindex = false } = Astro.props;
const canonical = site.href.abs(path);
const ogImage = site.href.abs('/og-default.jpg');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="alternate" hreflang={defaultLocale.code} href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={business.name} />
<meta property="og:locale" content={defaultLocale.ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#18176a" />
<link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
